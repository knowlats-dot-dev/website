{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "preserve",
    "lib": [
      "es2020"
    ],
    "target": "es2019",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "$/components/*": ["./src/components/*"],
      "$/layouts/*": ["./src/layouts/*"],
      "$/utils": ["./src/utils.ts"],
      "$/config": ["./src/config.ts"],
      "$/types": ["./src/types.ts"],
      "$/store/*": ["./src/store/*"],
      "$/styles/*": ["./src/styles/*"]
    },
    "types": [
      "astro/env"
    ],
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.astro",
    "src/**/*.svelte",

  ]
}
